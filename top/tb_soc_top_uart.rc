Magic 271485
Revision Verdi_U-2023.03-SP1

; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 25 1920 1000 350 200

signalSpacing 5

; ----------------------------------------------------------------------
; Group 1: System Clocks & Reset
; ----------------------------------------------------------------------
addGroup "1. System Clocks & Reset"
addSignal -h 15 /tb_soc_top/clk
addSignal -h 15 -holdScope rst_n

; ----------------------------------------------------------------------
; Group 2: RISC-V CPU Hex Execution Trace
; ----------------------------------------------------------------------
addGroup "2. RISC-V CPU Execution Trace (Hex Firmware)"
addSignal -h 15 /tb_soc_top/dut/rv_trace_valid
addSignal -h 15 -UNSIGNED -HEX -holdScope rv_trace_address[31:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope rv_trace_insn[31:0]

; ----------------------------------------------------------------------
; Group 3: CPU AXI4-Lite UART Writes
; ----------------------------------------------------------------------
addGroup "3. CPU AXI4-Lite UART Writes (TXDATA @ 0x4000_0008)"
addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/dut/m02_axil_awaddr[31:0]
addSignal -h 15 -holdScope m02_axil_awvalid
addSignal -h 15 -holdScope m02_axil_awready
addSignal -h 15 -ASCII -holdScope m02_axil_wdata[31:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope m02_axil_wdata[31:0]
addSignal -h 15 -holdScope m02_axil_wvalid
addSignal -h 15 -holdScope m02_axil_wready
addSignal -h 15 -holdScope m02_axil_bvalid
addSignal -h 15 -holdScope m02_axil_bready

; ----------------------------------------------------------------------
; Group 4: UART TX FIFO
; ----------------------------------------------------------------------
addGroup "4. UART TX FIFO"
addSignal -h 15 /tb_soc_top/dut/u_uart/u_axi_uart_top/u_tx_fifo/push_i
addSignal -h 15 -ASCII -holdScope data_in[7:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope data_in[7:0]
addSignal -h 15 -holdScope pull_i
addSignal -h 15 -ASCII -holdScope data_out[7:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope data_out[7:0]
addSignal -h 15 -holdScope empty_o
addSignal -h 15 -holdScope full_o

; ----------------------------------------------------------------------
; Group 5: UART Transmitter Core (Serialization & FSM)
; ----------------------------------------------------------------------
addGroup "5. UART Transmitter Core (Serialization & FSM)"
addSignal -h 15 /tb_soc_top/dut/u_uart/u_axi_uart_top/u_uart_controller/uart_transmitter_inst/tx_send_i
addSignal -h 15 -ASCII -holdScope tx_data_i[7:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope tx_data_i[7:0]
addSignal -h 15 -holdScope busy_o
addSignal -h 15 -holdScope tx_ready_o
addSignal -h 15 -UNSIGNED -BIN -holdScope state[4:0]
addSignal -h 15 -UNSIGNED -UDEC -holdScope bitcount_int[3:0]
addSignal -h 15 -UNSIGNED -UDEC -holdScope counter_int[15:0]
addSignal -h 15 -holdScope tx_o

; ----------------------------------------------------------------------
; Group 6: Top-Level UART Output & Verification Status
; ----------------------------------------------------------------------
addGroup "6. Top-Level UART Output & Verification Status"
addSignal -h 15 /tb_soc_top/uart_tx
addSignal -h 15 -ASCII -holdScope uart_rx_char[7:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope uart_rx_char[7:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope gpio_out[7:0]
addSignal -h 15 -UNSIGNED -BIN -holdScope pic_interrupts[5:0]
addSignal -h 15 -holdScope irq_core
